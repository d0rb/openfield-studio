# Copy to .env (never commit it). Leave both targets unset to run on recorded takes (Replay).

# Comfy Cloud (paid plan; models preinstalled):
# COMFY_API_KEY=comfyui-xxxxxxxx

# Your own GPU box, through an SSH tunnel to comfy-api-proxy (see docs/POD.md):
# COMFY_BASE_URL=http://127.0.0.1:9189

# auto = use the target above if one is set, otherwise Replay. Or force: sdk | replay
# OPENFIELD_BACKEND=auto
# OPENFIELD_HOST=127.0.0.1
# OPENFIELD_PORT=8877
# OPENFIELD_DATA_DIR=./data
